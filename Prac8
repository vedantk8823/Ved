#include <stdio.h> 
#include <conio.h> 
int n, M, w[20], x[20]; 
void sumOfSubsets(int s, int k, int r) { 
// s = current sum, k = index, r = remaining sum 
int i; 
x[k] = 1; 
if(s + w[k] == M) { 
printf("\nSubset found: "); 
for(i = 0; i <= k; i++) { 
if(x[i] == 1) 
printf("%d ", w[i]); 
} 
} 
else if(s + w[k] + w[k+1] <= M) { 
sumOfSubsets(s + w[k], k+1, r - w[k]); 
} 
if((s + r - w[k] >= M) && (s + w[k+1] <= M)) { 
x[k] = 0; 
sumOfSubsets(s, k+1, r - w[k]); 
} 
} 
void main() { 
int i, sum = 0; 
clrscr(); 
printf("Enter number of elements: "); 
scanf("%d", &n); 
printf("Enter the elements in increasing order: "); 
for(i = 0; i < n; i++) { 
scanf("%d", &w[i]); 
sum += w[i]; 
} 
printf("Enter the required sum: "); 
scanf("%d", &M); 
printf("\nSubsets that sum to %d are:\n", M); 
sumOfSubsets(0, 0, sum); 
getch(); 
}
