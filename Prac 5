#include <stdio.h> 
#include <conio.h> 
#define MAX 10 
#define INF 9999 
int n; 
int cost[MAX][MAX]; 
int visited[MAX]; 
int min_cost = INF; 
int tsp_path[MAX], temp_path[MAX]; 
void tsp(int city, int count, int current_cost) { 
int i; 
visited[city] = 1; 
temp_path[count] = city; 
if(count == n-1) { 
if(cost[city][0] != 0 && current_cost + cost[city][0] < min_cost) { 
min_cost = current_cost + cost[city][0]; 
for(i = 0; i < n; i++) 
tsp_path[i] = temp_path[i]; 
} 
visited[city] = 0; 
return; 
} 
for(i = 0; i < n; i++) { 
if(!visited[i] && cost[city][i] != 0) { 
tsp(i, count + 1, current_cost + cost[city][i]); 
} 
} 
visited[city] = 0; 
} 
void main() { 
int i, j; 
clrscr(); 
printf("Enter number of cities: "); 
scanf("%d", &n); 
printf("\nEnter Cost Matrix (0 if no direct path):\n"); 
for(i = 0; i < n; i++) 
for(j = 0; j < n; j++) 
scanf("%d", &cost[i][j]); 
for(i = 0; i < n; i++) 
visited[i] = 0; 
tsp(0, 0, 0);  // start from city 0 
printf("\nMinimum Cost: %d", min_cost); 
printf("\nOptimal Path: "); 
for(i = 0; i < n; i++) 
printf(" %d ->", tsp_path[i]); 
printf(" 0"); 
getch(); 
}
